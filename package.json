{
  "name": "solana-trojan-bot",
  "version": "2.0.0",
  "description": "Solana meme coin trading Telegram bot + Web Dashboard",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs');const f=(s,d)=>{fs.cpSync(s,d,{recursive:true,force:true})};f('src/web/views','dist/web/views');f('public','dist/public');console.log('Assets copied')\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.91.1",
    "axios": "^1.7.2",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "grammy": "^1.21.1",
    "mongoose": "^8.4.1",
    "pino": "^9.1.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5"
  }
}
